# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Duffel (flights and hotels - primary)
DUFFEL_ACCESS_TOKEN=duffel_test_your-token-here

# SerpAPI (optional fallback)
SERPAPI_KEY=

# Firebase Admin (backend auth verification and Firestore)
# Option A: path to a downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Option B: inline the service-account fields instead
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
FLASK_PORT=5001
FRONTEND_URL=http://localhost:5173
