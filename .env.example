# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ─── Amadeus (flights & hotels) ─────────────────────────────
# Sign up at https://developers.amadeus.com → create an app → copy keys
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
# "test" uses sandbox/mock data; "production" uses live data (requires
# Amadeus production approval)
AMADEUS_ENV=test

# ─── SerpAPI (optional — fallback for Google Flights/Hotels) ─
# Sign up at https://serpapi.com → copy your key
SERPAPI_KEY=

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Flask ───────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
FLASK_PORT=5001

# ─── Frontend ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
