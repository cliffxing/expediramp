# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ─── Duffel (flights & hotels — PRIMARY) ─────────────────────
# Sign up at https://app.duffel.com/ → Settings → Access tokens
# Use a token starting with "duffel_test_" for sandbox mode.
# Use a "duffel_live_" token for real bookings (requires Duffel approval).
DUFFEL_ACCESS_TOKEN=duffel_test_your-token-here

# ─── SerpAPI (optional — fallback for Google Flights/Hotels) ─
# Sign up at https://serpapi.com → copy your key
SERPAPI_KEY=

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Flask ───────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
FLASK_PORT=5001

# ─── Frontend ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
